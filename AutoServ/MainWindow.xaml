<Window x:Class="AutoServ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет заявок" Height="450" Width="1293">
    <Grid HorizontalAlignment="Left" Width="1053">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="Добавить заявку" Click="AddRequest_Click" Margin="5"/>
            <Button Content="Редактировать заявку" Click="EditRequest_Click" Margin="5"/>
        </StackPanel>

        <ListView x:Name="RequestList" Grid.Row="1" Margin="10,10,-193,10"
                  ItemsSource="{Binding Requests}" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Номер" DisplayMemberBinding="{Binding Number}" Width="80"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding AddedDate}" Width="120"/>
                    <GridViewColumn Header="ВидАвто" DisplayMemberBinding="{Binding CarType}" Width="120"/>
                    <GridViewColumn Header="МодельАвто" DisplayMemberBinding="{Binding CarModel}" Width="120"/>
                    <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="200"/>
                    <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding ClientLFP}" Width="150"/>
                    <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding PhoneNumber}" Width="120"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="120"/>
                    <GridViewColumn Header="Механик" DisplayMemberBinding="{Binding AssignedMechanic}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Text="Выберите заявку для редактирования" Grid.Row="2" HorizontalAlignment="Center" Margin="10"/>
    </Grid>
</Window>
