<Window x:Class="AutoServ.AddEditRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Редактировать заявку" Height="572" Width="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Модель авто:" Grid.Row="0"/>
        <TextBox x:Name="CarModelTextBox" Text="{Binding Request.CarModel, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Margin="0,5" IsEnabled="False"/>

        <TextBlock Text="Описание проблемы:" Grid.Row="2"/>
        <TextBox Text="{Binding Request.Description, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Margin="0,5" />

        <TextBlock Text="ФИО клиента:" Grid.Row="4"/>
        <TextBox x:Name="ClientLFPTextBox" Text="{Binding Request.ClientLFP, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Margin="0,5" IsEnabled="False"/>

        <TextBlock Text="Телефон:" Grid.Row="6"/>
        <TextBox x:Name="PhoneNumberTextBox" Text="{Binding Request.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Margin="0,5,0,294" IsEnabled="False"/>
        <TextBlock Text="Тип авто:" Grid.Row="7" Margin="0,49,0,67"/>
        <ComboBox ItemsSource="{Binding CarTypes}" 
          SelectedItem="{Binding Request.CarType, Mode=TwoWay}"
          Grid.Row="7" Margin="0,67,0,218"/>
        <TextBlock Text="Статус заявки:" Grid.Row="7" Margin="0,135,0,35"/>
        <ComboBox ItemsSource="{Binding RequestStatuses}" 
            SelectedItem="{Binding Request.Status, Mode=TwoWay}"
            Grid.Row="7" Margin="0,156,0,128"/>
        <TextBlock Text="Ответственный механик:" Grid.Row="7" Margin="0,234,0,53"/>
        <ComboBox ItemsSource="{Binding Mechanics}" 
          SelectedItem="{Binding SelectedMechanic, Mode=TwoWay}" 
          DisplayMemberPath="LFP"
          Grid.Row="7" Margin="0,256,0,29"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="8" Margin="0,10">
            <Button Content="Сохранить" Click="Save_Click" Width="100" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
